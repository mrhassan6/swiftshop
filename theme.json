{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "SwiftShop",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "860px",
			"wideSize": "1320px"
		},
		"color": {
			"custom": true,
			"customDuotone": false,
			"customGradient": true,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "primary",
					"color": "#2563EB",
					"name": "Primary Accent (Vibrant Blue)"
				},
				{
					"slug": "primary-hover",
					"color": "#1D4ED8",
					"name": "Primary Deep (Hover Blue)"
				},
				{
					"slug": "secondary-accent",
					"color": "#059669",
					"name": "Conversion Accent (Emerald)"
				},
				{
					"slug": "base",
					"color": "#FFFFFF",
					"name": "Base (Pure White)"
				},
				{
					"slug": "surface",
					"color": "#F8FAFC",
					"name": "Surface (Soft Pearl)"
				},
				{
					"slug": "surface-subtle",
					"color": "#F1F5F9",
					"name": "Surface Subtle (Warm Slate)"
				},
				{
					"slug": "contrast",
					"color": "#1E293B",
					"name": "Contrast (Readable Charcoal)"
				},
				{
					"slug": "text-muted",
					"color": "#64748B",
					"name": "Muted Text (Refined Slate)"
				},
				{
					"slug": "border",
					"color": "#E2E8F0",
					"name": "Border (Gentle Grey)"
				},
				{
					"slug": "highlight",
					"color": "#EFF6FF",
					"name": "Highlight (Sky Tint)"
				},
				{
					"slug": "mint",
					"color": "#ECFDF5",
					"name": "Mint (Fresh Tint)"
				},
				{
					"slug": "danger",
					"color": "#EF4444",
					"name": "Danger (Coral Red)"
				},
				{
					"slug": "warning",
					"color": "#F59E0B",
					"name": "Warning (Amber)"
				},
				{
					"slug": "success",
					"color": "#10B981",
					"name": "Success (Green)"
				},
				{
					"slug": "warm-cream",
					"color": "#FFFBEB",
					"name": "Warm Cream (Artisan Tone)"
				},
				{
					"slug": "sand",
					"color": "#FEF3C7",
					"name": "Sunlit Sand (Delicate Glow)"
				},
				{
					"slug": "blush",
					"color": "#FFF1F2",
					"name": "Soft Blush (Gentle Tint)"
				}
			],
			"gradients": [
				{
					"name": "Accent Gradient",
					"gradient": "linear-gradient(135deg, #2563EB 0%, #3B82F6 100%)",
					"slug": "accent-gradient"
				},
				{
					"name": "Conversion Gradient",
					"gradient": "linear-gradient(135deg, #059669 0%, #10B981 100%)",
					"slug": "conversion-gradient"
				},
				{
					"name": "Light Sky Glow",
					"gradient": "linear-gradient(135deg, #EFF6FF 0%, #F8FAFC 100%)",
					"slug": "light-glow"
				},
				{
					"name": "Mint Breeze",
					"gradient": "linear-gradient(135deg, #ECFDF5 0%, #EFF6FF 100%)",
					"slug": "mint-breeze"
				},
				{
					"name": "Sunset Glow",
					"gradient": "linear-gradient(135deg, #FFFBEB 0%, #EFF6FF 100%)",
					"slug": "sunset-glow"
				},
				{
					"name": "Artisan Warmth",
					"gradient": "linear-gradient(135deg, #FFF1F2 0%, #FEF3C7 100%)",
					"slug": "artisan-warmth"
				}
			]
		},
		"typography": {
			"fluid": true,
			"dropCap": false,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textColumns": false,
			"textDecoration": true,
			"textTransform": true,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen-Sans, Ubuntu, Cantarell, \"Helvetica Neue\", sans-serif",
					"name": "System UI (Fast)",
					"slug": "system"
				},
				{
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
					"name": "Monospace",
					"slug": "monospace"
				}
			],
			"fontSizes": [
				{
					"name": "Extra Small",
					"size": "0.75rem",
					"slug": "xs"
				},
				{
					"name": "Small",
					"size": "0.875rem",
					"slug": "sm"
				},
				{
					"name": "Medium",
					"size": "1rem",
					"slug": "base"
				},
				{
					"name": "Large",
					"size": "1.125rem",
					"slug": "md"
				},
				{
					"name": "Extra Large",
					"size": "1.25rem",
					"slug": "lg",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"name": "2X Large",
					"size": "1.5rem",
					"slug": "xl",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"name": "3X Large",
					"size": "1.875rem",
					"slug": "2xl",
					"fluid": {
						"min": "1.5rem",
						"max": "1.875rem"
					}
				},
				{
					"name": "4X Large",
					"size": "2.25rem",
					"slug": "3xl",
					"fluid": {
						"min": "1.75rem",
						"max": "2.25rem"
					}
				},
				{
					"name": "5X Large",
					"size": "3rem",
					"slug": "4xl",
					"fluid": {
						"min": "2.25rem",
						"max": "3rem"
					}
				}
			]
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true,
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"spacingScale": {
				"operator": "*",
				"increment": 1.5,
				"steps": 7,
				"mediumStep": 1.5,
				"unit": "rem"
			},
			"spacingSizes": [
				{
					"name": "2XS",
					"size": "0.25rem",
					"slug": "2xs"
				},
				{
					"name": "XS",
					"size": "0.5rem",
					"slug": "xs"
				},
				{
					"name": "SM",
					"size": "0.75rem",
					"slug": "sm"
				},
				{
					"name": "MD",
					"size": "1rem",
					"slug": "md"
				},
				{
					"name": "LG",
					"size": "1.5rem",
					"slug": "lg"
				},
				{
					"name": "XL",
					"size": "2rem",
					"slug": "xl"
				},
				{
					"name": "2XL",
					"size": "3rem",
					"slug": "2xl"
				},
				{
					"name": "3XL",
					"size": "4.5rem",
					"slug": "3xl"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0px",
				"right": "clamp(1rem, 3vw, 2rem)",
				"bottom": "0px",
				"left": "clamp(1rem, 3vw, 2rem)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-hover)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--3xl)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--2xl)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xl)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--lg)"
				}
			},
			"button": {
				"border": {
					"radius": "6px"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"right": "1.5rem",
						"bottom": "0.75rem",
						"left": "1.5rem"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--base)",
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-hover)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontWeight": "800",
					"fontSize": "var(--wp--preset--font-size--xl)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--sm)",
					"fontWeight": "500"
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "700"
				}
			}
		}
	}
}
